# Application
APP_ENV=demo
APP_BIND=0.0.0.0:8000
DEMO_MODE=true
DEMO_ACTOR_ALLOWLIST=demo-user-001,demo-user-002

# PostgreSQL bootstrap account: used by db only, never by app.
POSTGRES_DB=commerce_agent
POSTGRES_USER=commerce_agent_admin
POSTGRES_PASSWORD=replace-with-generated-admin-password
POSTGRES_MIGRATION_USER=commerce_agent_migration
POSTGRES_MIGRATION_PASSWORD=replace-with-generated-migration-password
POSTGRES_RUNTIME_USER=commerce_agent_runtime
POSTGRES_RUNTIME_PASSWORD=replace-with-generated-runtime-password
DATABASE_MIGRATION_URL=postgresql+psycopg://commerce_agent_migration:replace-with-generated-migration-password@db:5432/commerce_agent
DATABASE_URL=postgresql+psycopg://commerce_agent_runtime:replace-with-generated-runtime-password@db:5432/commerce_agent

# Agent model
MODEL=replace-with-agent-model-id
API_BASE=https://replace-with-openai-compatible-endpoint/v1
API_KEY=replace-with-agent-api-key

# Intent classifier. These three values must exactly match the Agent values.
CLASSIFIER_MODEL=replace-with-agent-model-id
CLASSIFIER_API_BASE=https://replace-with-openai-compatible-endpoint/v1
CLASSIFIER_API_KEY=replace-with-agent-api-key
CLASSIFIER_TEMPERATURE=0.1
CLASSIFIER_MAX_TOKENS=256

# Judge model. Development may fall back to Agent settings; release may not.
JUDGE_MODEL=replace-with-judge-model-id
JUDGE_API_BASE=https://replace-with-openai-compatible-endpoint/v1
JUDGE_API_KEY=replace-with-judge-api-key
